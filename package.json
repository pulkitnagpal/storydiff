{
  "name": "storydiff",
  "version": "0.1.0",
  "description": "The agent that made the PR hands it over like a person would: one checked card a reviewer reads in one look.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "storydiff": "bin/storydiff.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "node --test --experimental-strip-types --no-warnings 'test/**/*.test.ts' 'action/test/*.test.mjs'",
    "typecheck": "tsc --noEmit",
    "build": "node --experimental-strip-types --no-warnings scripts/build.ts",
    "compare": "node --experimental-strip-types --no-warnings scripts/compare.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "5.9"
  },
  "types": "./dist/types/index.d.ts",
  "keywords": [
    "code-review",
    "pull-request",
    "ai-agents",
    "claude-code",
    "review"
  ],
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulkitnagpal/storydiff.git"
  }
}
